{
  "name": "kubeflow-aks-docs-site",
  "description": "Documentation site for Kubeflow on AKS.",
  "private": true,
  "license": "MIT",
  "homepage": "https://azure.github.io/kubeflow-aks/main/",
  "bugs": "https://github.com/Azure/kubeflow-aks/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Azure/kubeflow-aks.git",
    "directory": "docs-site"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prebuild": "hugo mod npm pack",
    "build": "hugo --minify --cleanDestinationDir",
    "preserve": "hugo mod npm pack",
    "serve": "hugo server --disableFastRender",
    "clean": "rm -rf public resources .hugo_build.lock packages/hugoautogen/hugo_packagemeta.json",
    "update:docsy": "hugo mod get -u github.com/google/docsy/theme && hugo mod tidy && hugo mod npm pack && npm install"
  },
  "devDependencies": {
    "autoprefixer": "10.5.4",
    "hugo-extended": "0.164.0",
    "postcss-cli": "11.0.1"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "6.7.2",
    "bootstrap": "5.3.8"
  },
  "workspaces": [
    "packages/hugoautogen"
  ]
}
